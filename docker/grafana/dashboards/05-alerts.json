                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "text": "critical"
                      },
                      "high": {
                        "color": "orange",
                        "text": "high"
                      },
                      "medium": {
                        "color": "yellow",
                        "text": "medium"
                      },
                      "low": {
                        "color": "green",
                        "text": "low"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "payload"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 520
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
