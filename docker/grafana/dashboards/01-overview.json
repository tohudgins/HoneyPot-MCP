        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "honeypot-db"
      },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT COUNT(*) AS value FROM alerts WHERE severity = 'critical' AND timestamp BETWEEN datetime($__from / 1000, 'unixepoch') AND datetime($__to / 1000, 'unixepoch')",
          "queryType": "table",
          "timeColumns": [],
          "rawQueryText": "SELECT COUNT(*) AS value FROM alerts WHERE severity = 'critical' AND timestamp BETWEEN datetime($__from / 1000, 'unixepoch') AND datetime($__to / 1000, 'unixepoch')"
