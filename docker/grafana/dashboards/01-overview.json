          "refId": "A",
          "queryText": "SELECT COUNT(DISTINCT source_ip) AS value FROM alerts WHERE timestamp BETWEEN datetime($__from / 1000, 'unixepoch') AND datetime($__to / 1000, 'unixepoch')",
