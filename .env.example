# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./honeypot_mcp.db
# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/honeypot_mcp

# ── MCP transport ─────────────────────────────────────────────────────────────
# `stdio` (default): Claude Desktop / Claude Code spawn the server per chat.
#   The server lives only as long as the chat — fine for local use.
# `http`: run a PERSISTENT daemon (e.g. via systemd on a VPS) so honeypots keep
#   running 24/7 independent of any chat. Point your MCP client at
#   http://<host>:<port>/mcp. Required for real public deployments.
# `none`: collector mode — run the capture plane (honeypot engines, canary
#   callbacks, watchdog, webhook delivery, /metrics) with NO control plane.
#   Nothing can be deployed or queried remotely. This is what the Docker stack
#   uses, and the right choice for a detached container: stdio there would read
#   EOF from an unattached stdin and exit immediately.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Bearer token clients must present to the networked control plane. REQUIRED
# for http/sse (the server refuses to start without it) — the control plane can
# deploy honeypots and read all captured data. Generate: `openssl rand -hex 32`.
# Clients send it as `Authorization: Bearer <token>`. stdio ignores this.
MCP_AUTH_TOKEN=
# Set true ONLY if you front the networked control plane with your own auth
# (reverse proxy / trusted SSH tunnel) and accept running it without a token.
MCP_ALLOW_UNAUTHENTICATED=false

# ── Threat Intelligence APIs ──────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your_vt_api_key_here
# Free at abuseipdb.com — 1,000 checks/day
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ── GeoIP (MaxMind GeoLite2) ──────────────────────────────────────────────────
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DB_PATH=./config/GeoLite2-City.mmdb
# Optional separate ASN database (also free) — adds origin AS number + org,
# the key pivot for spotting hosting/VPN/botnet networks.
GEOIP_ASN_DB_PATH=./config/GeoLite2-ASN.mmdb
# Reverse-DNS (PTR) lookup during enrichment. Set false to disable on an
# air-gapped host.
GEOIP_REVERSE_DNS=true

# ── Canary Callback Server ────────────────────────────────────────────────────
# The HTTP server that receives honeytoken callbacks
CANARY_CALLBACK_HOST=0.0.0.0
CANARY_CALLBACK_PORT=8888
# Public URL where tokens phone home (use ngrok for local testing)
CANARY_PUBLIC_URL=http://localhost:8888

# ── Docker ────────────────────────────────────────────────────────────────────
# Leave blank to auto-detect the platform default (unix:///var/run/docker.sock
# on macOS/Linux). Only set this if Docker listens somewhere non-standard.
DOCKER_SOCKET=
# On Windows use: DOCKER_SOCKET=npipe:////./pipe/docker_engine
# Talking to a socket-proxy sidecar instead? Set DOCKER_HOST=tcp://host:2375.

# ── Honeypot Defaults ─────────────────────────────────────────────────────────
DEFAULT_SSH_PORT=2222
DEFAULT_HTTP_PORT=8080
DEFAULT_FTP_PORT=2121
DEFAULT_SMTP_PORT=2525
DEFAULT_DNS_PORT=5353
DEFAULT_RDP_PORT=3389
DEFAULT_VNC_PORT=5900
DEFAULT_REDIS_PORT=6379
DEFAULT_MYSQL_PORT=3306
DEFAULT_ELASTICSEARCH_PORT=9200
DEFAULT_SMB_PORT=445
DEFAULT_POSTGRESQL_PORT=5432
DEFAULT_MONGODB_PORT=27017
DEFAULT_MSSQL_PORT=1433

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
