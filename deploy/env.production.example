# Production profile for a public honeypot VPS: /opt/honeypot-mcp/.env  (root:honeypot, mode 0640)
#
#   sudo install -m 0640 -o root -g honeypot deploy/env.production.example /opt/honeypot-mcp/.env
#   sudo $EDITOR /opt/honeypot-mcp/.env      # fill in the three tokens, nothing else is required
#
# What differs from .env.example, and why. Every address below is loopback: the only things
# reachable from the internet are the honeypot ports (and your admin SSH port), nothing else. The
# firewall (deploy/harden-host.sh) enforces that independently; binding to loopback is the first
# line, the firewall the second, and `scripts/preflight.sh` checks both.

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# The one directory the sandboxed service may write (create it owned by `honeypot`).
DATABASE_URL=sqlite+aiosqlite:////opt/honeypot-mcp/data/honeypot_mcp.db

# ── Control plane ────────────────────────────────────────────────────────────────────────────
# A persistent daemon (the honeypots outlive any chat), loopback only, reached over an SSH tunnel.
# The port is moved off the default 8000 so a stray `localhost:8000` is never this server; the
# protection is the loopback bind, the firewall and the tokens, not the number.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=18443
# One token per role, 32+ random characters each (`openssl rand -hex 32`):
#   viewer   read-only: lists, alerts, reports. Use this for reading the data.
#   operator viewer + deploy/stop honeypots, tokens, webhooks, suppression, pcap.
#   admin    operator + prune alerts, push blocklists to a firewall, API keys, audit log.
# Do not give a model-driven session `admin`. The single MCP_AUTH_TOKEN is an implicit admin
# token; leave it empty and use MCP_AUTH_TOKENS.
MCP_AUTH_TOKEN=
MCP_AUTH_TOKENS=CHANGE_ME_viewer_token:viewer,CHANGE_ME_operator_token:operator,CHANGE_ME_admin_token:admin
MCP_ALLOW_UNAUTHENTICATED=false

# ── Everything else that listens: loopback, moved, or off ────────────────────────────────────
# Metrics (/metrics, /readyz) on loopback, off the default 9090.
METRICS_HOST=127.0.0.1
METRICS_PORT=19090
# The web console is an unauthenticated dashboard of every captured credential: disabled.
CONSOLE_PORT=0
# The canary callback server defaults to 0.0.0.0:8888. This run uses no canary URL tokens (the
# planted credentials trip on the honeypots' own logins), so it listens on loopback only. Set it
# back to 0.0.0.0 and open the port in the firewall if you add URL canaries.
CANARY_CALLBACK_HOST=127.0.0.1
CANARY_CALLBACK_PORT=18888
CANARY_PUBLIC_URL=http://127.0.0.1:18888

# ── Containers ───────────────────────────────────────────────────────────────────────────────
# Cowrie may not start connections of its own. `wget`/`curl` inside the honeypot then fail (the
# attacker's URL is still logged from the command line). To also capture the downloaded malware,
# set COWRIE_ALLOW_EGRESS=true AND render the firewall with `--egress limited`
# (harden-host.sh finalize --egress limited --dns <resolver>): containers may then fetch from
# public web servers only, 30 connections/minute, 512 KB/s, never private space or the cloud
# metadata service. See docs/HARDENING.md "Malware sample capture".
COWRIE_ALLOW_EGRESS=false

# ── Limits and privacy ───────────────────────────────────────────────────────────────────────
MAX_CONNECTIONS_PER_IP=32
WEBHOOK_ALLOW_PRIVATE_DESTINATIONS=false
# A PTR lookup of each attacker address would be sent from this host's resolver to a zone the
# attacker may control: it announces the sensor. Off.
GEOIP_REVERSE_DNS=false
# Keep everything for a 24-hour run; archive before deleting anything later.
RETENTION_DAYS=0
# One scanner can send hundreds of events a second (a SIP sweep did, 190 a second, 1.1M to 4.9M rows
# in nine hours). Per (source, event type) the first N events a minute are stored and the rest are
# counted into one flood_summary event, so volume stays visible; CRITICAL and honeytoken hits are
# never dropped. 0 disables it.
FLOOD_GUARD_PER_MINUTE=600
# Identical CRITICAL alerts from one source are coalesced on Slack/Teams/email for this long.
NOTIFY_CRITICAL_REPEAT_SECONDS=900
# Cowrie keeps recordings and download records in RAM-backed tmpfs; every failed download leaves an
# empty file and a telnet botnet makes tens of thousands, which the container memory limit counts.
# Clean-up runs inside the container (the Docker guard refuses exec): empty leftovers older than 5 min
# are removed and only the newest recordings kept. Applies to containers created after this setting.
COWRIE_JANITOR_INTERVAL_SECONDS=300
COWRIE_MAX_TTY_FILES=5000
LOG_LEVEL=INFO

# ── Optional ─────────────────────────────────────────────────────────────────────────────────
# Packet capture only records from the moment it is switched on, so decide before the run.
# Needs the unit drop-in in deploy/honeypot-mcp.service and free disk (PCAP_FILE_MB x PCAP_FILES).
PCAP_ENABLED=false
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
