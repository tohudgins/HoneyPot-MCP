# systemd unit for the HoneyPot MCP control plane on a public VPS.
#
# This runs the server as a PERSISTENT daemon over HTTP transport, so the
# honeypots you deploy through natural language keep running 24/7 — independent
# of any chat session. Your MCP client (Claude Code / Claude Desktop) connects
# to it over an SSH tunnel at http://127.0.0.1:<MCP_PORT>/mcp (see docs/DEPLOY.md).
#
# Install (deploy/harden-host.sh prepare does all of this for you):
#   sudo cp deploy/honeypot-mcp.service deploy/honeypot-docker-guard.service \
#           deploy/honeypot-firewall.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now honeypot-mcp          # starts the Docker guard first
#   journalctl -u honeypot-mcp -f                      # live logs
#
# The service reads configuration from /opt/honeypot-mcp/.env (EnvironmentFile);
# start from deploy/env.production.example.
#
# Layout assumed by the sandbox below:
#   /opt/honeypot-mcp            owned by root, read-only to the service
#   /opt/honeypot-mcp/.venv      built with `uv sync --frozen --no-dev`
#   /opt/honeypot-mcp/.env       root:honeypot, mode 0640
#   /opt/honeypot-mcp/{data,reports,tls,pcap}   owned by honeypot — the ONLY
#                                writable paths (DB, exports, TLS keys, captures)

[Unit]
Description=HoneyPot MCP control plane (persistent daemon)
After=network-online.target honeypot-docker-guard.service
Wants=network-online.target
# The Docker guard, not docker.service: this process never talks to Docker directly.
Requires=honeypot-docker-guard.service

[Service]
Type=simple
# A dedicated non-login user. It is deliberately NOT in the `docker` group.
# Membership in `docker` is root-equivalent (anyone who can ask the daemon can
# start a privileged container that bind-mounts `/`), and this process parses
# attacker-controlled bytes all day, so a bug in it must not reach that. It
# reaches Docker only through the guard (honeypot-docker-guard.service), a
# separate process that forwards just the Cowrie container operations the SSH
# engine makes and refuses everything else (see hardening/docker_guard.py).
#   sudo useradd --system --home /opt/honeypot-mcp --shell /usr/sbin/nologin honeypot
User=honeypot
Group=honeypot
WorkingDirectory=/opt/honeypot-mcp
EnvironmentFile=/opt/honeypot-mcp/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DOCKER_HOST=unix:///run/honeypot-docker/docker.sock
# The venv's own entry point — no `uv` on the runtime path, no resolution or
# network access at start. Build it with: uv sync --frozen --no-dev
ExecStart=/opt/honeypot-mcp/.venv/bin/honeypot-mcp
Restart=on-failure
RestartSec=5
# The reconcile step re-establishes RUNNING honeypots on every restart, so a
# crash-restart transparently brings the fleet back.

# ── Resource limits ──────────────────────────────────────────────────────────
# One socket per attacker connection plus per-engine listeners: the default
# 1024 file descriptors is exhausted by a modest scan.
LimitNOFILE=65536
# Thread/process ceiling (executor threads, docker-py, tcpdump child).
TasksMax=512
# Hard memory ceiling so a flood cannot take the host down with it. Tune to
# the machine: on a 1 GB VPS set 768M so the OOM killer picks this unit, not sshd.
MemoryMax=1G
# No core dumps: they would contain captured credentials and the control token.
LimitCORE=0

# ── Hardening ────────────────────────────────────────────────────────────────
# The daemon processes untrusted attacker payloads all day. Constrain it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Other processes (and their command lines) are invisible to this one.
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
SystemCallArchitectures=native
# A deny-list rather than an allow-list on purpose: Python and its native
# extensions use a wide set of ordinary calls, and an allow-list that is one
# call short kills the daemon at 3 a.m. These are the calls an exploited
# daemon would need to escape: privilege changes, mounts, module loading,
# raw I/O, reboot, kernel keyrings, ptrace-style process inspection.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @module @raw-io @reboot @swap @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
UMask=0077
# Everything else is read-only (ProtectSystem=strict). Only the data the server
# genuinely writes is writable: DB, generated reports/archives, TLS keys, pcap.
# Code, .venv and .env are NOT writable, so a compromised process cannot
# persist by rewriting itself or its configuration.
ReadWritePaths=/opt/honeypot-mcp/data /opt/honeypot-mcp/reports /opt/honeypot-mcp/tls /opt/honeypot-mcp/pcap
# No Linux capabilities: every honeypot engine listens on an unprivileged port
# (>1024). The firewall redirects the well-known ports (80, 110, ...) to them,
# so this unit never needs CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=
# Sockets the server uses: IP, the Docker guard's unix socket, netlink for
# interface lookups. (Packet capture also needs AF_PACKET — see the drop-in below.)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# ── Optional: packet capture (PCAP_ENABLED=true) ─────────────────────────────
# tcpdump needs CAP_NET_RAW + CAP_NET_ADMIN and raw packet sockets. With
# NoNewPrivileges a `setcap` on the tcpdump binary is ignored, so grant them
# to the unit instead, in a drop-in (`sudo systemctl edit honeypot-mcp`):
#   [Service]
#   CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
#   AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
#   RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
# Leave it out entirely if you do not use packet capture.

[Install]
WantedBy=multi-user.target
